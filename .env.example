# ============================================================================
# Signal — environment variables
# Copy this file to .env.local for local dev, or set these in the Vercel
# project's Environment Variables page for deployment.
# ============================================================================

# REQUIRED. Private key of the wallet that pays for and signs every 0G
# Storage upload and every 0G Compute inference request on behalf of the
# app. Fund this address with 0G testnet tokens from https://faucet.0g.ai
# It needs at least ~3.5 0G to open a Compute ledger (protocol minimum is
# 3 0G) plus a small amount for storage-upload gas.
#
# Never reuse a wallet that holds real funds. Use a fresh wallet created
# just for this deployment.
ZG_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional overrides — sane testnet defaults are used if omitted.
# ---------------------------------------------------------------------------

# 0G Chain EVM JSON-RPC endpoint.
ZG_EVM_RPC=https://evmrpc-testnet.0g.ai

# 0G Storage indexer endpoint (the "turbo" testnet indexer).
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# Pin inference to one specific provider address. If unset, Signal
# auto-selects the first acknowledged, healthy provider returned by
# broker.inference.listService().
ZG_COMPUTE_PROVIDER_ADDRESS=

# For multi-model providers, pin a specific model id (see
# broker.inference.getProviderModels). If unset, the provider's on-chain
# default model is used.
ZG_COMPUTE_MODEL=

# Amount (in 0G) used to open the Compute ledger the first time the app
# runs. Must be >= 3 (the protocol's MIN_ACCOUNT_BALANCE).
ZG_LEDGER_INITIAL_OG=3.5

# When the ledger's available balance drops below this many 0G, Signal
# tops it up automatically by ZG_LEDGER_TOPUP_OG.
ZG_LEDGER_MIN_BALANCE_OG=0.5

# Amount (in 0G) deposited into the ledger on each auto top-up.
ZG_LEDGER_TOPUP_OG=1
